{
  "name": "reseau-miawstral",
  "version": "2.0.0",
  "description": "API temps réel et calculateur d'itinéraires pour le Réseau Mistral (Toulon), à partir des données ouvertes officielles.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "bun install && cd client && bun install",
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"bun run client:dev\"",
    "dev:api": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "client:dev": "cd client && bun run dev",
    "client:build": "cd client && bun install --frozen-lockfile && bun run build"
  },
  "keywords": [
    "reseau-mistral",
    "toulon",
    "gtfs",
    "gtfs-rt",
    "raptor",
    "transport",
    "api"
  ],
  "author": "Ivy-Js",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
