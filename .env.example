# Copy this file to .env and adapt it. Every variable is optional.

PORT=3000
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info
# Comma separated list of allowed origins, * for any
CORS_ORIGIN=*

# Where the timetables (<line>_horaires.json) are read and written
DATA_DIR=./data
# Built React client served on / (cd client && bun run build)
CLIENT_DIR=./client/dist
# Time zone used for "now" when no departure time is given
TZ_NETWORK=Europe/Paris
# When only one direction of a line was scraped, mirror it to estimate the other one
ESTIMATE_MISSING_DIRECTIONS=true

# OSRM servers for street-level geometries. One osrm-routed serves one profile:
# OSRM_FOOT_URL draws the walks, OSRM_CAR_URL the bus legs, OSRM_URL is used for both otherwise.
# Without OSRM, itineraries are drawn with straight lines between stops.
# docker compose starts both (see docker-compose.yml).
USE_OSRM=true
OSRM_URL=
OSRM_FOOT_URL=
OSRM_CAR_URL=
OSRM_TIMEOUT_MS=3000
OSRM_COOLDOWN_MS=60000

# Scraping (npm run scrape / POST /api/data/refresh) goes through FlareSolverr
FLARESOLVERR_URL=http://localhost:8191/v1
FLARESOLVERR_TIMEOUT_MS=60000
# Lines scraped in parallel (one browser each) and pause between two lines
SCRAPER_CONCURRENCY=2
SCRAPER_DELAY_MS=500
SCRAPER_MAX_RETRIES=3
SCRAPER_MAX_LINE_ID=300
# Day of the timetables to scrape (YYYY-MM-DD). Default: the next working day.
SCRAPER_DATE=
# Refresh the timetables every N hours (0 = never). At startup, a refresh runs at once
# when the data is missing, in the legacy format, or older than that.
AUTO_REFRESH_HOURS=0
AUTO_REFRESH_DELAY_MS=20000

# Bearer token required by POST /api/data/refresh. Refresh endpoints are disabled when empty.
ADMIN_TOKEN=
