# Copy this file to .env and adapt it. Every variable is optional.

PORT=3000
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info
# Comma separated list of allowed origins, * for any
CORS_ORIGIN=*
# Requests per minute and per IP on /api/routes and /api/isochrone (0 = unlimited)
RATE_LIMIT_PER_MINUTE=120

# Cache of the downloaded timetables (gtfs.zip)
DATA_DIR=./data
# Built React client served on / (cd client && bun run build)
CLIENT_DIR=./client/dist
# Time zone of the network
TZ_NETWORK=Europe/Paris

# Official open data of the Réseau Mistral (transport.data.gouv.fr)
GTFS_URL=https://www.data.gouv.fr/api/1/datasets/r/b0789d9e-5077-4124-b6b2-773353ada8cf
# Check for new timetables every N hours (0 = never)
GTFS_REFRESH_HOURS=12

# Real time (GTFS-RT): vehicle positions, delays, alerts
REALTIME=true
GTFS_RT_VEHICLES_URL=https://www.data.gouv.fr/api/1/datasets/r/9fe8291c-2fb2-4f89-b578-282ba05dd999
GTFS_RT_TRIP_UPDATES_URL=https://www.data.gouv.fr/api/1/datasets/r/10f2e5d4-6a1b-45e2-897a-5b9044ebb6b3
GTFS_RT_ALERTS_URL=https://www.data.gouv.fr/api/1/datasets/r/f30614b3-a35b-4c9f-98c9-7450585d3941
# Feeds are fetched on demand, at most once per this many seconds
REALTIME_VEHICLES_TTL=10
REALTIME_TRIP_UPDATES_TTL=20
REALTIME_ALERTS_TTL=120

# OSRM server for walking paths (docker compose starts one). Without it, walks are straight lines.
USE_OSRM=true
OSRM_FOOT_URL=
OSRM_TIMEOUT_MS=3000
OSRM_COOLDOWN_MS=60000

# Bearer token required by POST /api/data/refresh (forces a timetable download). Disabled when empty.
ADMIN_TOKEN=
